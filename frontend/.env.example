# En développement, Vite proxifie /api vers le backend Laravel.
# En production séparée, renseignez l'URL complète incluant /api/v1.
# VITE_API_URL=https://api.votre-domaine.mg/api/v1

# Aucun identifiant administrateur ne doit être exposé dans une variable VITE_* :
# ces variables sont intégrées au JavaScript envoyé au navigateur.
